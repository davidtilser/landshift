{
  "name": "landshift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/setup-cesium.mjs",
    "predev:game": "node scripts/setup-cesium.mjs",
    "prebuild": "node scripts/setup-cesium.mjs",
    "dev": "vite",
    "dev:game": "vite --open /game.html",
    "data:prepare": "node scripts/data/prepare-san-jose.mjs && node scripts/data/prepare-cesium.mjs",
    "data:cesium": "node scripts/data/prepare-cesium.mjs",
    "data:verify": "node scripts/data/verify-san-jose.mjs",
    "data:bundle": "npm run data:verify && tar -czf data/san-jose-dc04.tar.gz -C public/data san-jose-dc04",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "data:prepare:golden-gate": "node scripts/data/prepare-golden-gate.mjs && node scripts/data/prepare-cesium.mjs golden-gate-park",
    "data:verify:golden-gate": "node scripts/data/verify-san-jose.mjs golden-gate-park",
    "data:bundle:golden-gate": "npm run data:verify:golden-gate && tar -czf data/golden-gate-park.tar.gz -C public/data golden-gate-park"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "pbf": "^5.1.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@cesium/core": "^0.1.0",
    "@cesium/engine": "^26.4.0",
    "@turf/area": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "cesium": "^1.146.0",
    "earcut": "^3.2.4",
    "zod": "^4.6.7"
  }
}
