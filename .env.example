# Browser-visible, read-only Cesium ion token. Restrict access in your ion account.
# Enable Google Photorealistic 3D Tiles in that account.
VITE_CESIUM_ION_TOKEN=

# Server-only. Never prefix this key with VITE_.
OPENROUTER_API_KEY=
# Cheapest Gemini text-chat option in the checked OpenRouter catalog (2026-10-24).
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
