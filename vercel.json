{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "supportsCancellation": true,
      "includeFiles": "public/data/{golden-gate-park,san-jose-dc04}/{buildings,trees,water,parks,flood,heritage}.geojson"
    }
  }
}
